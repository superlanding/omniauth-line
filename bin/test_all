#!/usr/bin/env bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "========================================="
echo "Running tests for all Ruby versions"
echo "========================================="
echo ""

RUBY_VERSIONS=(
  "2.7.6"
  "3.0.7"
  "3.1.7"
)

FAILED_TESTS=()
PASSED_TESTS=()

# Check if rbenv or rvm is available
if command -v rbenv &> /dev/null; then
  VERSION_MANAGER="rbenv"
elif command -v rvm &> /dev/null; then
  VERSION_MANAGER="rvm"
else
  echo -e "${YELLOW}Warning: Neither rbenv nor rvm found. Testing with current Ruby version only.${NC}"
  echo "========================================="

  ruby_version=$(ruby -v)
  echo -e "${YELLOW}Current Ruby: $ruby_version${NC}"
  echo "========================================="

  if bundle install && bundle exec rspec; then
    echo -e "${GREEN}✓ Tests passed${NC}"
    exit 0
  else
    echo -e "${RED}✗ Tests failed${NC}"
    exit 1
  fi
fi

for version in "${RUBY_VERSIONS[@]}"; do
  echo -e "${YELLOW}Testing with Ruby $version${NC}"
  echo "========================================="

  # Check if version is installed
  if [ "$VERSION_MANAGER" = "rbenv" ]; then
    if ! rbenv versions | grep -q "$version"; then
      echo -e "${YELLOW}⚠ Ruby $version not installed (skipping)${NC}"
      echo ""
      continue
    fi
    RUBY_CMD="rbenv local $version && "
  else
    if ! rvm list | grep -q "$version"; then
      echo -e "${YELLOW}⚠ Ruby $version not installed (skipping)${NC}"
      echo ""
      continue
    fi
    RUBY_CMD="rvm use $version && "
  fi

  if eval "$RUBY_CMD bundle install --quiet && bundle exec rspec"; then
    echo -e "${GREEN}✓ Tests passed with Ruby $version${NC}"
    PASSED_TESTS+=("Ruby $version")
  else
    echo -e "${RED}✗ Tests failed with Ruby $version${NC}"
    FAILED_TESTS+=("Ruby $version")
  fi

  echo ""
done

echo "========================================="
echo "Test Summary"
echo "========================================="
echo ""

if [ ${#PASSED_TESTS[@]} -gt 0 ]; then
  echo -e "${GREEN}Passed (${#PASSED_TESTS[@]}):${NC}"
  for test in "${PASSED_TESTS[@]}"; do
    echo -e "  ${GREEN}✓${NC} $test"
  done
  echo ""
fi

if [ ${#FAILED_TESTS[@]} -gt 0 ]; then
  echo -e "${RED}Failed (${#FAILED_TESTS[@]}):${NC}"
  for test in "${FAILED_TESTS[@]}"; do
    echo -e "  ${RED}✗${NC} $test"
  done
  echo ""
  exit 1
else
  echo -e "${GREEN}All tests passed!${NC}"
  exit 0
fi
